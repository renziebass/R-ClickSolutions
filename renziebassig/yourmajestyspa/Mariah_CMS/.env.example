# =============================================================
# Mariah_CMS — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# =============================================================

# --- Application ---------------------------------------------
APP_ENV=production
APP_DEBUG=false
# Public base URL of the CMS folder, no trailing slash.
# Local (XAMPP):   http://localhost/rclicksolutions/renziebassig/yourmajestyspa/Mariah_CMS
# Hostinger:       https://yourdomain.com/renziebassig/yourmajestyspa/Mariah_CMS
APP_URL=
# Fallback timezone only, used before the database is readable. The live value
# is the "Timezone" site setting, chosen during setup.php and changeable by a
# Super Admin under Settings. Any IANA name; defaults to America/New_York.
APP_TIMEZONE=America/New_York

# --- Database -------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# --- Session / CSRF -------------------------------------------
# Random 64-char string. Generate with:  php -r "echo bin2hex(random_bytes(32));"
SESSION_SECRET=
SESSION_NAME=mariah_cms_session
# Idle timeout in seconds before a session is invalidated (default 8 hours).
SESSION_IDLE_TIMEOUT=28800
# Set false ONLY for local http development. Must be true in production.
SESSION_COOKIE_SECURE=true

# --- Media storage --------------------------------------------
# Filesystem dir for uploads (relative to Mariah_CMS/, or absolute).
STORAGE_PATH=storage/uploads
# Public URL prefix that maps to STORAGE_PATH.
STORAGE_URL=/renziebassig/yourmajestyspa/Mariah_CMS/storage/uploads
# Max upload size in bytes (5 MB). Must be <= PHP upload_max_filesize.
UPLOAD_MAX_BYTES=5242880
# Max size of a services CSV import (2 MB). A 500-row menu is around 60 KB.
# Applies to a pasted Google Sheets link too — the fetch aborts past this size.
SERVICE_IMPORT_MAX_BYTES=2097152

# --- Testing (optional) ---------------------------------------
# A real, link-shared Google Sheet for tests/smoke.php to import from. Leave
# empty and that one test is skipped rather than failed.
SMOKE_SHEET_URL=

# --- Login rate limiting --------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Seed admin account ---------------------------------------
# Used ONLY by database/seed.php to create the first Super Admin.
# CHANGE THE PASSWORD BEFORE PRODUCTION. The seed refuses to run without these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Majesty
ADMIN_LAST_NAME=Administrator

# --- Public API CORS ------------------------------------------
# Comma-separated origins allowed to call /api/public/*. Empty = same-origin only.
PUBLIC_CORS_ORIGINS=

# --- Browser installer ----------------------------------------
# Unlocks setup.php, for hosting without SSH where the CLI scripts cannot run.
# Must be at least 16 characters. Generate with:
#   php -r "echo bin2hex(random_bytes(16));"
# Leave EMPTY (or delete setup.php) once the CMS is installed — with no token
# set, setup.php refuses to do anything.
SETUP_TOKEN=
