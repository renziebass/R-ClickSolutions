# =============================================================
# Mariah_CMS — Apache configuration
# =============================================================

Options -Indexes

# --- Block direct HTTP access to server-side code -------------
RedirectMatch 404 (?i)/Mariah_CMS/(app|config|database|tests)/
RedirectMatch 404 (?i)/Mariah_CMS/storage/logs/
RedirectMatch 404 (?i)/Mariah_CMS/\.env

# Require is Apache 2.4 syntax; guard it so a 2.2 host does not 500.
<IfModule mod_authz_core.c>
  <FilesMatch "^\.env">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^\.env">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# --- API front controller -------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Everything under api/ that is not a real file goes to the front controller.
  RewriteCond %{REQUEST_URI} (?i)/Mariah_CMS/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # Preserve the Authorization header on CGI/FastCGI setups.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# --- Security headers -----------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
